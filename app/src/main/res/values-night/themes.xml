<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Studreminder" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_celtic_blue</item>
        <item name="colorPrimaryVariant">@color/brand_celtic_blue</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/brand_vanilla</item>
        <item name="colorSecondaryVariant">@color/brand_vanilla</item>
        <item name="colorOnSecondary">@color/brand_dark_brown</item>

        <item name="android:windowBackground">@color/brand_dark_brown</item>
        <item name="android:statusBarColor">@color/brand_dark_brown</item>

        <!-- Material Pickers -->
        <item name="materialCalendarTheme">@style/BrandDatePicker</item>
        <item name="materialTimePickerTheme">@style/BrandTimePicker</item>
    </style>

    <style name="Theme.Studreminder.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.Studreminder.Picker" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/brand_celtic_blue</item>
        <item name="colorAccent">@color/brand_celtic_blue</item>
        <item name="android:windowBackground">@color/brand_ivory</item>
        <item name="android:textColorPrimary">@color/brand_dark_brown</item>
        <item name="android:textColorSecondary">@color/brand_dark_brown</item>
        <item name="colorOnSurface">@color/brand_dark_brown</item>
        <item name="materialCalendarTheme">@style/BrandDatePicker</item>
        <item name="materialTimePickerTheme">@style/BrandTimePicker</item>
    </style>

    <!-- REQUIRED: Fixes the resource linking error -->
    <style name="Widget.Studreminder.BrutalInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/white</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:textColorHint">@color/brand_vanilla</item>
        <item name="hintTextColor">@color/brand_vanilla</item>
        <item name="boxBackgroundColor">@color/brand_dark_brown</item>
    </style>

    <style name="Widget.Studreminder.BrutalButton" parent="Widget.MaterialComponents.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/brutal_button</item>
        <item name="android:textColor">@color/brand_dark_brown</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="backgroundTint">@null</item>
        <item name="rippleColor">@color/brand_vanilla</item>
    </style>

    <!-- Date Picker Overlay -->
    <style name="BrandDatePicker" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorSurface">@color/brand_ivory</item>
        <item name="colorPrimary">@color/brand_celtic_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSurface">@color/brand_dark_brown</item>
        <item name="android:headerBackground">@color/brand_celtic_blue</item>
        <item name="buttonBarPositiveButtonStyle">@style/BrandPickerButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/BrandPickerButton</item>
    </style>

    <!-- Time Picker Overlay -->
    <style name="BrandTimePicker" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorSurface">@color/brand_ivory</item>
        <item name="colorPrimary">@color/brand_celtic_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSurface">@color/brand_dark_brown</item>
        <item name="android:headerBackground">@color/brand_celtic_blue</item>
        <item name="android:numbersBackgroundColor">@color/brand_ivory</item>
        <item name="android:numbersTextColor">@color/brand_dark_brown</item>
        <item name="android:numbersSelectorColor">@color/brand_celtic_blue</item>
        <item name="android:amPmTextColor">@color/brand_dark_brown</item>
        <item name="buttonBarPositiveButtonStyle">@style/BrandPickerButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/BrandPickerButton</item>
    </style>

    <!-- Custom Color for the OK/CANCEL buttons (Night - Paper Style) -->
    <style name="BrandPickerButton"
        parent="Widget.MaterialComponents.Button.TextButton.Dialog">

        <item name="android:textColor">@color/brand_celtic_blue</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>

    </style>

</resources>