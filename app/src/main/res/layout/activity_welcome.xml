<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/brand_ivory"
    android:padding="32dp">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_remindly_logo"
        android:contentDescription="@string/logo_description" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/app_name"
        android:textColor="@color/brand_dark_brown"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:text="@string/onboarding_text"
        android:textAlignment="center"
        android:textColor="@color/brand_dark_brown"
        android:textSize="16sp"
        android:textStyle="bold"
        android:alpha="0.7" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoToLogin"
        style="@style/Widget.Studreminder.BrutalButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="24dp"
        android:text="@string/login_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoToRegister"
        style="@style/Widget.Studreminder.BrutalButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/create_new_account"
        app:rippleColor="@color/accent_blue_light" />

</LinearLayout>