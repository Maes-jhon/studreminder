<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:background="@color/brand_vanilla"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="Back"
                android:padding="12dp"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#202735" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/btnArchiveReview"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="Archive"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_save"
                app:tint="#202735" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Enterprise Architecture"
            android:textColor="#202735"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInstructor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Topic: Zachman Framework"
            android:textColor="#444444"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSchedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="August 10, 2026 • 7:00 PM"
            android:textColor="#444444"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Reminder: 15 minutes before"
            android:textColor="#444444"
            android:textSize="15sp" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-25dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/accent_yellow"
                app:tabIndicatorFullWidth="false"
                app:tabMode="scrollable"
                app:tabSelectedTextColor="@color/accent_yellow"
                app:tabTextColor="@color/brand_tea_green" />

            <FrameLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- EMPTY STATE -->
                <LinearLayout
                    android:id="@+id/emptyLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:contentDescription="Empty"
                        android:src="@android:drawable/ic_menu_info_details"
                        app:tint="#C7CBD3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Nothing here yet."
                        android:textColor="#202735"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEmptyDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Add your first to-do."
                        android:textColor="#888888"
                        android:textSize="14sp" />

                </LinearLayout>


                <!-- TO-DO LIST -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerTodos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone" />


                <!-- NOTES LIST -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerNotes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone" />


                <!-- FILE LIST -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerFiles"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone" />


                <!-- STUDY SET LIST -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerStudySets"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone" />


                <!-- LINK LIST -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerLinks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd"
                    style="@style/Widget.Studreminder.BrutalButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="+ New To-do" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportWord"
                    style="@style/Widget.Studreminder.BrutalButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:padding="0dp"
                    android:visibility="gone"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/brand_dark_brown" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>