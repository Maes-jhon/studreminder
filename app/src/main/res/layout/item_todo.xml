<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_brutal_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTodoTask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Task Name"
                android:textColor="@color/true_black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTodoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADET"
                    android:textColor="@color/brand_celtic_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/labelDivider"
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/true_black"
                    android:alpha="0.2" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ongoing"
                    android:textColor="@color/true_black"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_clock_simple"
                    android:drawablePadding="6dp"
                    app:drawableTint="@color/true_black" />
            </LinearLayout>
        </LinearLayout>

        <CheckBox
            android:id="@+id/checkTodo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/brutal_box_white"
            android:button="@null"
            android:checked="false" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
