<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_ivory"
    android:padding="20dp">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_round_button"
        android:src="@android:drawable/ic_media_previous"
        android:padding="12dp"
        android:contentDescription="@string/btn_back_description"
        app:tint="#202735"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_add_review"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/brand_dark_brown"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"/>

    <!-- Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardReview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_brutal_card"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Subject -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Studreminder.BrutalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_subject"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/true_black"
                app:boxStrokeWidth="2dp"
                app:boxStrokeWidthFocused="3dp"
                android:textColorHint="@color/brand_dark_brown"
                app:hintTextColor="@color/brand_dark_brown">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSubject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:textColor="@color/brand_dark_brown"
                    android:textStyle="bold" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Topic -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Studreminder.BrutalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/hint_topic"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/true_black"
                app:boxStrokeWidth="2dp"
                app:boxStrokeWidthFocused="3dp"
                android:textColorHint="@color/brand_dark_brown"
                app:hintTextColor="@color/brand_dark_brown">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTopic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_dark_brown" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Date -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Studreminder.BrutalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/hint_review_date"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/true_black"
                app:boxStrokeWidth="2dp"
                app:boxStrokeWidthFocused="3dp"
                android:textColorHint="@color/brand_dark_brown"
                app:hintTextColor="@color/brand_dark_brown">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:clickable="true"
                    android:textColor="@color/brand_dark_brown" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Time -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Studreminder.BrutalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/hint_review_time"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/true_black"
                app:boxStrokeWidth="2dp"
                app:boxStrokeWidthFocused="3dp"
                android:textColorHint="@color/brand_dark_brown"
                app:hintTextColor="@color/brand_dark_brown">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:clickable="true"
                    android:textColor="@color/brand_dark_brown" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Status -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Studreminder.BrutalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Status"
                app:endIconMode="dropdown_menu"
                app:endIconTint="@color/brand_dark_brown"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/true_black"
                app:boxStrokeWidth="2dp"
                app:boxStrokeWidthFocused="3dp"
                android:textColorHint="@color/brand_dark_brown"
                app:hintTextColor="@color/brand_dark_brown">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/dropdownStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_dark_brown" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Reminder -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Studreminder.BrutalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/hint_reminder"
                app:endIconMode="dropdown_menu"
                app:endIconTint="@color/brand_dark_brown"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/true_black"
                app:boxStrokeWidth="2dp"
                app:boxStrokeWidthFocused="3dp"
                android:textColorHint="@color/brand_dark_brown"
                app:hintTextColor="@color/brand_dark_brown">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/dropdownReminder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_dark_brown" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Save -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveReview"
                style="@style/Widget.Studreminder.BrutalButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="28dp"
                android:text="@string/btn_save_review"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>